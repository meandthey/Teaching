xlim = c(0, 4),
ylim = c(0, 1100),
xlab = "수량",
ylab = "가격",
xaxt = "n",  # 기본 x축 안 그림
main = "지불의사 (계단형)",
cex.axis = 1.2,
cex.lab = 1.5,
cex.main = 2)
# 사용자 정의 x축 (0,1,2,3,4)
