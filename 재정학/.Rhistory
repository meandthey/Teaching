arrows(xlim[1], 0, xlim[2], 0, length = 0.08, lwd = 2)
arrows(0, ylim[1], 0, ylim[2], length = 0.08, lwd = 2)
# 축 라벨
text(xlim[2], -0.35, xlab_txt, cex = cex, xpd = NA)
text(-0.35, ylim[2], ylab_txt, cex = cex, xpd = NA)
}
